# ─── VERCEL FRONTEND ENVIRONMENT CONFIGURATION ───
# Deployed Frontend URL
NEXT_PUBLIC_APP_URL=https://agriculture-automation.vercel.app

# Production Backend API URL
NEXT_PUBLIC_API_URL=https://api.agriculture-automation.com

# Production WebSocket Real-Time Event Bus URL
NEXT_PUBLIC_WS_URL=wss://api.agriculture-automation.com/ws

# Production MQTTS Hostname (Used for ESP32 & ESP8266 Firmware Generation)
NEXT_PUBLIC_MQTT_HOST=mqtt.agriculture-automation.com
NEXT_PUBLIC_MQTT_PORT=8883
