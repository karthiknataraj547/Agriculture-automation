# ─── PRODUCTION BACKEND ENVIRONMENT CONFIGURATION ───
PORT=4000
NODE_ENV=production

# Frontend URL (Used for Strict CORS Configuration)
APP_URL=https://agriculture-automation.vercel.app

# Public API URL
API_URL=https://api.agriculture-automation.com

# Production MQTT Broker Service
MQTT_HOST=mqtt.agriculture-automation.com
MQTT_PORT=8883
MQTT_TLS=true
MQTT_USERNAME=aether_backend_service
MQTT_PASSWORD=SUPER_SECURE_MQTT_SERVICE_PASSWORD

# PostgreSQL / TimescaleDB Connection String
DATABASE_URL=postgresql://aether_user:aether_password@postgres.internal:5432/aethercrop_db?sslmode=require

# Redis Event Bus & Cache Connection String
REDIS_URL=redis://:redis_password@redis.internal:6379/0

# Authentication & Security Secrets
JWT_SECRET=aether_super_secret_jwt_key_prod_2026
DEVICE_PROVISIONING_SECRET=aether_device_provisioning_master_key_2026
ENCRYPTION_SECRET=aethercrop-military-grade-aes-256-gcm-key-2026
