# --- Stage 1: Build Frontend App ---
FROM node:20-alpine AS builder
WORKDIR /app

# Copy root monorepo files
COPY package.json package-lock.json ./
COPY packages/shared ./packages/shared
COPY apps/frontend ./apps/frontend

# Install dependencies and build shared package + Next.js frontend
RUN npm ci
RUN npm run build --prefix packages/shared
RUN npm run build --prefix apps/frontend

# --- Stage 2: Runtime Runner ---
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000

COPY --from=builder /app/package.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/frontend ./apps/frontend
COPY --from=builder /app/packages/shared ./packages/shared

EXPOSE 3000

CMD ["npm", "run", "start", "--workspace=apps/frontend"]
